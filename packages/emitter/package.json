{
  "name": "@hcstar/emitter",
  "version": "0.0.2",
  "description": "事件触发器",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "scripts": {
    "build": "vite build",
    "publish": "npm publish"
  },
  "repository": "https://github.com/hc-star-h/hcstar_utils",
  "homepage": "https://github.com/hc-star-h/hcstar_utils/blob/master/packages/emitter/README.md",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.es.js",
      "require": "./dist/*.cjs.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ]
}
